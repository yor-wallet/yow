# DOOM | دوم — environment variables
# Copy to `.env` and fill in. Never commit real secrets.

# --- Core -------------------------------------------------------------------
# PostgreSQL (Supabase-compatible). On Supabase use the pooled URL here and set
# DIRECT_URL for migrations if you enable it in prisma/schema.prisma.
DATABASE_URL=postgresql://postgres@localhost:5432/doom
# Used by vitest (unit tests touching the DB) and the Playwright web server.
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/doom_test

# Public base URL of the site (no trailing slash). Used for metadata, origin
# checks and absolute links (receipts, emails).
APP_URL=http://localhost:3000

# Random secret (>= 32 bytes, base64). Signs short-lived tokens (lib/auth/tokens.ts).
# Generate: openssl rand -base64 48
SESSION_SECRET=

# 32-byte key (base64 or hex) for AES-256-GCM encryption of KYC documents and
# gift-card codes. Generate: openssl rand -base64 32
# Losing this key makes encrypted files unreadable. Rotate with a re-encryption job.
KYC_ENCRYPTION_KEY=

# Initial superadmin created by `npm run db:seed` (password only set on creation).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret for /api/cron/* endpoints (sent as `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=

# Set to "false" only for local HTTP testing of a production build on non-Chromium
# browsers. Session cookies are `Secure` in production by default.
SESSION_COOKIE_SECURE=

# --- Storage ----------------------------------------------------------------
# local (default) | supabase
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public
SUPABASE_PRIVATE_BUCKET=private

# --- Payment providers (leave empty => provider shown as "unavailable") -------
# Card gateway (e.g. Thawani Pay or a bank gateway)
CARD_GATEWAY_PROVIDER=
CARD_GATEWAY_API_URL=
CARD_GATEWAY_SECRET_KEY=
CARD_GATEWAY_PUBLISHABLE_KEY=
CARD_GATEWAY_WEBHOOK_SECRET=

# Ooredoo Oman carrier billing
OOREDOO_API_URL=
OOREDOO_MERCHANT_ID=
OOREDOO_API_KEY=
OOREDOO_WEBHOOK_SECRET=

# Omantel carrier billing
OMANTEL_API_URL=
OMANTEL_MERCHANT_ID=
OMANTEL_API_KEY=
OMANTEL_WEBHOOK_SECRET=

# Crypto payments via a licensed provider (BTC, ETH, USDT, USDC)
CRYPTO_PROVIDER=
CRYPTO_API_URL=
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=

# DOOM FLEX finance partner
FLEX_PARTNER_NAME=
FLEX_PARTNER_API_URL=
FLEX_PARTNER_API_KEY=
FLEX_PARTNER_WEBHOOK_SECRET=
